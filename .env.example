# Eating Helper Environment Variables

# ==========================================
# Gemini AI (Optional Default Key)
# ==========================================
# Users can also configure and save their personal Gemini API Key inside the app Settings.
VITE_GEMINI_API_KEY=

# ==========================================
# Firebase Authentication Configuration
# ==========================================
# Obtain these credentials from the Firebase Console (Project Settings > General > Your apps > Web app)
# Required for Google Sign-In and Email/Password authentication.
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# ==========================================
# Admin Configuration
# ==========================================
# Comma-separated list of admin email addresses allowed to access the Admin Panel
VITE_ADMIN_EMAILS=admin@dunhas.com
# Admin Password reference (for local testing / Firebase admin login)
ADMIN_PASSWORD=

# ==========================================
# Remote Storage API Key (db.dunhas.com)
# ==========================================
VITE_DB_API_KEY=

